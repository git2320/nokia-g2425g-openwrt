CONFIG_TARGET_econet=y
CONFIG_TARGET_econet_en7528=y
CONFIG_TARGET_econet_en7528_DEVICE_nokia_g-2425g-a=y
CONFIG_TARGET_ROOTFS_UBIFS=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_KERNEL_GIT_LOCALVERSION="-nokia"
CONFIG_ALL_KMODS=n
CONFIG_ALL_NONSHARED=n

# Keep the image small by dropping the web UI only. The networking core
# (ubus/ubusd/libubus/libuci + netifd + firewall4 + dnsmasq) MUST stay:
# netifd DEPENDS on +libubus +ubus +ubusd +libuci, and dnsmasq on +libubus.
# Pruning any of those makes kconfig drop netifd, firewall4 and dnsmasq
# silently, which produces exactly the v2/v4 symptom: kernel boots, the
# switch negotiates link, but no interface is ever configured - no bridge,
# no IP, no DHCP, no open ports. See PHASE5-BOOT-CAUSE.md.
CONFIG_PACKAGE_luci=n
CONFIG_PACKAGE_luci-app-*=n
CONFIG_PACKAGE_luci-theme-*=n
CONFIG_PACKAGE_luci-mod-*=n
CONFIG_PACKAGE_uhttpd=n
CONFIG_PACKAGE_rpcd=n
CONFIG_PACKAGE_rpcd-mod-*=n

CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_LZMA=y
