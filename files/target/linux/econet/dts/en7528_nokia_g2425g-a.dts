// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
// Nokia G-2425G-A (Airtel) — EN7528, MT7603 (2.4G) + MT7663 (5G).
// Hardware is the Airtel-branded DASAN H660GM-A family, but flash layout
// differs from the Dasan units; partition map from live NAND dump
// (see PHASE2-FINDINGS.md in this project).
//
// Reverse-engineering notes (from stock dump):
//   - LED GPIO map: stock firmware uses proprietary tcledctrl reading
//     /userfs/led.conf. GPIO numbering matches the DASAN H660GM-A
//     reference (same EN7528 SoC family): power=29, wlan2g=34, wlan5g=36,
//     reset_btn=0, wps_btn=30, lan1=37, lan2=35, lan3=33, lan4=31.
//     GPIO0-GPIO41 are the pins with a GPIO function on the EN7528 pinctrl.
//   - Ethernet: dumb-switch mode (econet-eth driver), MT7530 switch
//     bridged in hardware to gmac0. &switch stays disabled.
//   - MAC: from ri partition offset 0x3e (verified against live dump).

#include "en7528.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Nokia G-2425G-A";
	compatible = "nokia,g-2425g-a", "dasan,h660gm-a-airtel", "econet,en7528";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
		linux,usable-memory-range = <0x00020000 0x0ffe0000>;
		bootargs = "console=ttyS0,115200 root=ubi0:rootfs ubi.mtd=ubi";
	};

	leds {
		compatible = "gpio-leds";

		/* Power LED — GPIO 29 from DASAN H660GM-A reference map. */
		led_power: pwr {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&pinctrl 29 GPIO_ACTIVE_LOW>;
		};

		/* WiFi 2.4 GHz LED — GPIO 34, tied to phy0tpt trigger. */
		led_wlan2g: wlan2g {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN_2GHZ;
			gpios = <&pinctrl 34 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		/* WiFi 5 GHz LED — GPIO 36, tied to phy1tpt trigger. */
		led_wlan5g: wlan5g {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN_5GHZ;
			gpios = <&pinctrl 36 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy1tpt";
		};

		/* LAN port LEDs — switch PHY LED pins muxed as GPIO.
		 * Active-low, one per LAN socket (ports 1-4). */
		led_lan1: lan1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <1>;
			gpios = <&pinctrl 37 GPIO_ACTIVE_LOW>;
		};

		led_lan2: lan2 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <2>;
			gpios = <&pinctrl 35 GPIO_ACTIVE_LOW>;
		};

		led_lan3: lan3 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <3>;
			gpios = <&pinctrl 33 GPIO_ACTIVE_LOW>;
		};

		led_lan4: lan4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <4>;
			gpios = <&pinctrl 31 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";
		poll-interval = <100>;

		key-reset {
			label = "reset";
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	/* GPIO0-GPIO15 can raise interrupts; the rest must be polled.
	 * WPS button on GPIO 30 uses the polled keys. */
	keys-polled {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		key-wps {
			label = "wps";
			gpios = <&pinctrl 30 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&slot0 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&macaddr_ri 0>;
		nvmem-cell-names = "mac-address";
		ieee80211-freq-limit = <2400000 2500000>;
	};
};

&slot1 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&macaddr_ri 1>;
		nvmem-cell-names = "mac-address";
		ieee80211-freq-limit = <5000000 6000000>;
	};
};

&gmac0 {
	status = "okay";
	nvmem-cells = <&macaddr_ri 0>;
	nvmem-cell-names = "mac-address";
};

/*
 * Ethernet: dumb-switch mode via econet-eth driver.
 *
 * The driver bridges the on-die MT7530 in hardware (all LAN ports <-> CPU
 * port 6 <-> gmac0) whenever its register window covers the switch block.
 * Keep &switch disabled so the MT7530 DSA driver does not bind, and widen
 * the ethernet register window to 0x10000 so has_switch_regs is true
 * (covers both the frame engine at 0x1fb50000 and the switch at 0x1fb58000).
 */
&ethernet {
	reg = <0x1fb50000 0x10000>;
};

&nand {
	status = "okay";
	econet,bmt;
	econet,bbt-table-size = <250>;

	partitions: partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x40000>;
			read-only;
		};

		partition@40000 {
			label = "romfile";
			reg = <0x40000 0x40000>;
			read-only;
		};

		partition@80000 {
			label = "image0";
			reg = <0x80000 0x2200000>;
		};

		linux_kernel: partition@2280000 {
			label = "linux_kernel";
			reg = <0x2280000 0x400000>;
		};

		/* UBI rootfs volume — inside the linux slot, right after the
		 * 4 MB kernel area. Kept separate from the stock "rootfs"
		 * partition so image0 stays a genuine recovery slot. */
		ubi: partition@2680000 {
			label = "ubi";
			reg = <0x2680000 0x1e00000>;
		};

		stock_rootfs: partition@4480000 {
			label = "rootfs";
			reg = <0x4480000 0x1e20000>;
			read-only;
		};

		partition@6260000 {
			label = "image_oflt";
			reg = <0x6260000 0xf00000>;
		};

		partition@7160000 {
			label = "config";
			reg = <0x7160000 0x800000>;
		};

		partition@7960000 {
			label = "log";
			reg = <0x7960000 0xc00000>;
		};

		partition@8560000 {
			label = "extfs";
			reg = <0x8560000 0x600000>;
		};

		partition@8b60000 {
			label = "bosa";
			reg = <0x8b60000 0x40000>;
		};

		partition@8ba0000 {
			label = "flag";
			reg = <0x8ba0000 0x40000>;
		};

		partition@8be0000 {
			label = "flagback";
			reg = <0x8be0000 0x40000>;
		};

		ri: partition@8c20000 {
			label = "ri";
			reg = <0x8c20000 0x40000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				/* MAC at offset 0x3e inside the ri partition
				 * (verified against live dump). */
				macaddr_ri: macaddr@3e {
					compatible = "mac-base";
					reg = <0x3e 0x6>;
					#nvmem-cell-cells = <1>;
				};
			};
		};

		partition@8c60000 {
			label = "riback";
			reg = <0x8c60000 0x40000>;
			read-only;
		};

		partition@8ca0000 {
			label = "data";
			reg = <0x8ca0000 0x6e00000>;
		};
	};
};
