# Extra top-level .config additions for the Nokia G-2425G-A image.
# Appended AFTER config.seed by CI, so these win over the seed.
#
# Only symbols that exist in OpenWrt's own Kconfig may appear here:
#   CONFIG_PACKAGE_<package-name>     real package name, hyphens preserved
#   CONFIG_TARGET_* / CONFIG_KERNEL_* (the allowlist in config/Config-kernel.in)
#
# Raw kernel options (CONFIG_SPI, CONFIG_MTD_UBI, CONFIG_NF_CONNTRACK, ...) are
# NOT part of .config. `make defconfig` silently drops unknown symbols, so
# writing them here does nothing at all. Kernel options live in
# target/linux/<target>/config-<kernelversion>; en7528/config-6.18 already
# enables SPI, SPI_MASTER, SPI_AIROHA_SNFI, MTD_SPI_NAND, MTD_UBI and UBIFS_FS.
#
# Punctuation matters too: CONFIG_PACKAGE_kmod_mt7663_firmware_ap is inert,
# CONFIG_PACKAGE_kmod-mt7663-firmware-ap is the real symbol.

# Drivers this board needs. These are also listed in DEVICE_PACKAGES in
# files/target/linux/econet/image/en7528.mk; keeping them here means a build
# that skips the device profile still gets a working image.
CONFIG_PACKAGE_kmod-econet-eth=y
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7663-firmware-ap=y
CONFIG_PACKAGE_kmod-usb2=y

# Flash tools: nand-utils for sysupgrade, mtd for econet-bootlog and
# bootflag-commit (both call /sbin/mtd).
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_mtd=y
