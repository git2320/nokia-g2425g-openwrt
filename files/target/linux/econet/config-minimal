# Minimal kernel config for Nokia G-2425G-A
# Disable unused subsystems to speed up build

# Filesystems we don't need
CONFIG_EXT4_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_XFS_FS=n
CONFIG_JFFS2_FS=n
CONFIG_NTFS_FS=n
CONFIG_VFAT_FS=n
CONFIG_MSDOS_FS=n
CONFIG_NLS=n

# Network protocols we don't need
CONFIG_IPV6=n
CONFIG_IPV6_MULTIPLE_TABLES=n
CONFIG_NETFILTER_XT_TARGET_LOG=n
CONFIG_NETFILTER_XT_MATCH_STATE=n
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=n
CONFIG_NF_CONNTRACK=n
CONFIG_NF_NAT=n
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=n
CONFIG_NETFILTER_XT_TARGET_REDIRECT=n
CONFIG_NETFILTER_XT_MATCH_COMMENT=n
CONFIG_NETFILTER_XT_MATCH_LIMIT=n
CONFIG_NETFILTER_XT_MATCH_MAC=n
CONFIG_NETFILTER_XT_MATCH_MARK=n
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=n
CONFIG_NETFILTER_XT_MATCH_TCPMSS=n
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=n

# Wireless - we use mt76, not ath/mac80211 subsystems directly
CONFIG_CFG80211_WEXT=n
CONFIG_MAC80211_MESH=n
CONFIG_MAC80211_LEDS=n
CONFIG_MAC80211_DEBUGFS=n

# USB - minimal
CONFIG_USB_STORAGE=n
CONFIG_USB_SERIAL=n
CONFIG_USB_GADGET=n

# Crypto - minimal
CONFIG_CRYPTO_USER=n
CONFIG_CRYPTO_USER_API=n
CONFIG_CRYPTO_HASH=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_MD5=y

# Debug - disable
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_FS=n
CONFIG_KALLSYMS_ALL=n

# Sound - not needed
CONFIG_SOUND=n

# Input - minimal
CONFIG_INPUT_EVDEV=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MOUSE=n

# PCI - we need it for wifi
# CONFIG_PCI=y (keep)

# I2C/SPI - minimal
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_SPI_MASTER=n

# GPIO - we use it for LEDs/reset
# CONFIG_GPIOLIB=y (keep)

# LEDS - we use them
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y

# Watchdog - we need it
CONFIG_WATCHDOG=y

# MTD - we need it
CONFIG_MTD=y
CONFIG_MTD_SPLIT=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_MTD_NAND=y
CONFIG_MTD_NAND_ECC=y

# Network - we need ethernet and wifi
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_MEDIATEK=y
CONFIG_WLAN=y

# Our drivers
CONFIG_PACKAGE_kmod_econet_eth=y
CONFIG_PACKAGE_kmod_mt76=y
CONFIG_PACKAGE_kmod_mt7603=y
CONFIG_PACKAGE_kmod_mt7615=y
CONFIG_PACKAGE_kmod_mt7663_firmware_ap=y

# Crypto for wifi
CONFIG_CRYPTO_AES_ARM=n
CONFIG_CRYPTO_AES_NI_INTEL=n
CONFIG_CRYPTO_AES_TI=n