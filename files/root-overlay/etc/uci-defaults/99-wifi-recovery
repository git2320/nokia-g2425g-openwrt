#!/bin/sh
# Recovery defaults: bring every detected radio up with an open SSID out of
# the box, so the box stays reachable even if Ethernet is broken.
#
# Radio numbering depends on PCIe probe order (mt7603 is 2.4 GHz, mt7663 is
# 5 GHz), so do not hardcode radio0/radio1: walk whatever `wifi config`
# created and name the SSID after the radio's band.
[ -f /etc/config/wireless ] || wifi config
[ -f /etc/config/wireless ] || exit 0

radios=$(uci -q show wireless | sed -n 's/^wireless\.\(radio[0-9][0-9]*\)=.*/\1/p')
[ -n "$radios" ] || exit 0

for r in $radios; do
	band=$(uci -q get wireless.$r.band)
	[ -n "$band" ] || band=$(uci -q get wireless.$r.hwmode)
	case "$band" in
	*5*) suffix="-5G" ;;
	*)   suffix="" ;;
	esac

	uci -q set wireless.$r.disabled=0
	uci -q set wireless.$r.country=IN
	uci -q set wireless.$r.channel=auto

	# Default AP interface generated by `wifi config` for this radio.
	uci -q set wireless.default_$r.ssid="G2425G-Recovery$suffix"
	uci -q set wireless.default_$r.encryption=none
	uci -q set wireless.default_$r.network=lan
	uci -q set wireless.default_$r.disabled=0
done

uci commit wireless
exit 0
