#!/bin/sh
# First-boot default root password.
#
# Why this exists: the image ships without LuCI/uhttpd, and OpenWrt's stock
# /etc/shadow locks root (root:!), so dropbear refuses every login. A box that
# is reachable but refuses root is not really recoverable without a serial
# cable. This sets a documented password once, on first boot only.
#
# Default: root / nokia2425     -- CHANGE IT after the first login:
#     passwd
#
# If you dislike a default password, delete this file and instead flash the
# image with your own /etc/shadow, or keep a USB-TTL cable on hand.
[ -f /etc/shadow ] || exit 0

if grep -q '^root:[!*]' /etc/shadow; then
	sed -i 's|^root:[^:]*:|root:$1$nokia242$bBQcvevOs1NDBSXU/QVRT0:|' /etc/shadow
	logger -t root-password "default root password applied (change it: passwd)"
fi

# Make sure the SSH server is enabled for that login.
/etc/init.d/dropbear enable 2>/dev/null

exit 0
