#!/bin/sh /etc/rc.common
# Persist boot diagnostics to the stock "log" MTD partition.
#
# The board has no usable serial console, and CONFIG_PANIC_TIMEOUT=1 makes
# the kernel reboot a second after a panic.  Logging therefore has three
# layers, oldest first:
#
#   1. pstore/ramoops (kernel) writes panic/oops/console records to reserved
#      RAM -- this survives the reset itself.
#   2. /lib/preinit/05_bootlog_early copies those records to mtd7 and leaves
#      a "PREINIT reached" marker before any network/WiFi setup.
#   3. This script adds a full userspace snapshot (dmesg, logread, network,
#      wireless, flags) at START=11 and again at +10s / +80s.
#
# If the kernel dies before preinit, only layer 1 has data.  On the next
# boot (or after CFE reverts to stock) layer 2 copies it to mtd7, where it
# can be read with:
#
#   dd if=/dev/mtd7 bs=128k count=16 2>/dev/null | strings | less

START=11

LOGTAG="OpenWrt boot snapshot"

find_log_mtd_num() {
	sed -n 's/^mtd\([0-9]*\):.*"log"/\1/p' /proc/mtd 2>/dev/null | head -n1
}

snapshot() {
	echo "=== $LOGTAG ($(date -u)) uptime=$(cut -d' ' -f1 /proc/uptime 2>/dev/null) ==="

	# Preinit marker and pstore records from previous boots.
	[ -f /tmp/.bootlog.early ] && cat /tmp/.bootlog.early

	echo "--- cmdline ---"
	cat /proc/cmdline 2>/dev/null
	echo "--- dmesg ---"
	dmesg 2>/dev/null
	echo "--- logread ---"
	logread 2>/dev/null
	echo "--- mtd ---"
	cat /proc/mtd 2>/dev/null
	echo "--- bootflag (raw) ---"
	local fp
	fp=$(sed -n 's/^mtd\([0-9]*\):.*"flag"/\/dev\/mtd\1/p' /proc/mtd 2>/dev/null | head -n1)
	if [ -n "$fp" ] && command -v hexdump >/dev/null 2>&1; then
		hexdump -C -n 64 "$fp" 2>/dev/null
	fi
	echo "--- links ---"
	ip -o link 2>/dev/null
	ip -o addr 2>/dev/null
	echo "--- netdev state ---"
	local n
	for n in /sys/class/net/*; do
		echo "## ${n##*/}: operstate=$(cat $n/operstate 2>/dev/null) carrier=$(cat $n/carrier 2>/dev/null) addr=$(cat $n/address 2>/dev/null) speed=$(cat $n/speed 2>/dev/null) device=$(readlink $n/device 2>/dev/null)"
	done
	echo "--- counters ---"
	grep -H . /sys/class/net/*/statistics/rx_packets /sys/class/net/*/statistics/tx_packets 2>/dev/null
	echo "--- interrupts ---"
	grep -iE 'qdma|gsw|eth|mt76' /proc/interrupts 2>/dev/null
	echo "--- modules ---"
	lsmod 2>/dev/null
	echo "--- uci network ---"
	uci show network 2>/dev/null
	echo "--- wireless ---"
	uci show wireless 2>/dev/null
	iw dev 2>/dev/null
	echo "--- pstore ---"
	local f
	for f in /sys/fs/pstore/*; do
		[ -f "$f" ] || continue
		echo "## $f"
		head -c 16384 "$f" 2>/dev/null
	done
}

write_snapshot() {
	local num
	num=$(find_log_mtd_num)
	[ -n "$num" ] || return 0
	snapshot > /tmp/.bootlog.current 2>/dev/null
	if command -v mtd >/dev/null 2>&1; then
		mtd write /tmp/.bootlog.current log 2>/dev/null || \
			dd if=/tmp/.bootlog.current of=/dev/mtdblock$num bs=4096 conv=notrunc 2>/dev/null || true
	else
		dd if=/tmp/.bootlog.current of=/dev/mtdblock$num bs=4096 conv=notrunc 2>/dev/null || true
	fi
	sync
}

boot() {
	# No "log" partition -> nothing to do.
	[ -n "$(find_log_mtd_num)" ] || exit 0

	# Full snapshot immediately: if userspace dies at START=12 or later,
	# this is still on flash.  The background copies below add settled
	# network/wifi state.
	write_snapshot

	(
		sleep 10
		write_snapshot
		sleep 70
		write_snapshot
	) </dev/null >/dev/null 2>&1 &
}

start() { :; }
