#!/bin/sh /etc/rc.common
# Acknowledge a successful boot in the EcoNet/ASB dual-boot flag.
#
# Why this runs at every boot and not once:
#
#   CFE increments boot_fail_num on every boot it does not consider committed,
#   and after 9 (the same bootloader family's threshold) it flips to the other
#   bank and marks this one invalid. A one-shot commit therefore does not
#   survive: a perfectly working OpenWrt is reverted to stock after nine power
#   cycles. The counter has to be reset on each successful boot, which is
#   exactly what stock firmware does through swdl_commit.
#
#   Committing here does not remove the safety net, because this point is only
#   reached when the image actually reached userspace *and* brought the LAN up.
#   A kernel panic, a missing netifd or a dead Ethernet driver never gets here,
#   so the counter keeps counting and CFE still reverts after nine failures.
#
# Manual use (force a commit even if the LAN check fails):
#
#   bootflag-commit          # commit bank 1 ("linux")
#   bootflag-commit -b 0     # commit bank 0 ("image0")
#   bootflag-commit -n       # dry run

START=98

lan_reachable() {
	# ubus knows the real state; fall back to the interface address in case
	# ubus is not up yet or netifd uses a different interface name.
	if command -v ubus >/dev/null 2>&1; then
		ubus call network.interface.lan status 2>/dev/null \
			| grep -q '"up": *true' && return 0
	fi
	for dev in br-lan eth0; do
		ip -4 addr show dev "$dev" 2>/dev/null | grep -q 'inet ' && return 0
	done
	return 1
}

boot() {
	if lan_reachable; then
		logger -t econet-commit "LAN is up; committing bank 1 and resetting boot_fail_num"
		/usr/sbin/bootflag-commit -q \
			|| logger -t econet-commit "boot flag write failed"
	else
		logger -t econet-commit "LAN is not up; not committing (CFE keeps counting)"
	fi
}

start() {
	exec /usr/sbin/bootflag-commit "$@"
}
